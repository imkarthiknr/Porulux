# Supabase — backend uses service role (bypasses RLS); never expose this client-side
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini API (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key

# CORS — comma-separated list of allowed frontend origins
# Local:      ALLOWED_ORIGINS=http://localhost:3000
# Production: ALLOWED_ORIGINS=https://porulux.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Gemini model used for document extraction (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
