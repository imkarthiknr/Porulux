# Supabase — anon key is safe to expose; used for auth on the client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend
# Local:      http://localhost:8000
# Production: Cloud Run URL (and leave NEXT_PUBLIC_API_URL unset: browser uses the same-origin /api proxy)
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Note: ANTHROPIC_API_KEY belongs on the backend (apps/api/.env), not here
